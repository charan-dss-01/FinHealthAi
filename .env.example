# Database Connection (SQLite / PostgreSQL)
DATABASE_URL="file:./dev.db"
NODE_ENV="development"

# ==========================================
# Google Gemini API Configuration (PRIMARY)
# ==========================================
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional secondary keys for automatic key rotation on rate limits:
# GEMINI_API_KEY_2="your_second_gemini_api_key_here"
# GEMINI_API_KEY_3="your_third_gemini_api_key_here"

# Models (Defaults to ultra-fast 2.5 Flash and reasoning 3.6 Flash)
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_REASONING="gemini-3.6-flash"

# ==========================================
# Groq API Configuration (AUTOMATIC FALLBACK)
# ==========================================
# Get your free key from Groq Console: https://console.groq.com/keys
# (Optional but recommended so your Copilot never goes down if Gemini hits 429 rate limit)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Groq Fallback Models
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_REASONING="llama-3.3-70b-versatile"

# Provider Timeout & Limits (Optional)
AI_REQUEST_TIMEOUT_MS=12000

# ==========================================
# Twilio WhatsApp Configuration
# ==========================================
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_CONTENT_SID="HXb5b62575e6e4ff6129ad7c8efe1f983e"

# ==========================================
# Resend Email Configuration
# ==========================================
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="FinHealth AI <onboarding@resend.dev>"

# Optional Cron Security Secret for scheduled reminder trigger endpoint
CRON_SECRET="your_secure_cron_secret_here"
