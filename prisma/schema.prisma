datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  phone             String?
  name              String
  passwordHash      String?
  role              String     @default("OWNER")
  preferredLanguage String     @default("en")
  businesses        Business[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Business {
  id                  String            @id @default(uuid())
  ownerId             String
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  category            String
  size                String?
  location            String?
  monthlyRevenueRange String?
  employeeCount       Int               @default(1)
  currency            String            @default("INR")
  bankAccounts        BankAccount[]
  transactions        Transaction[]
  metrics             BusinessMetric[]
  signals             FinancialSignal[]
  alerts              Alert[]
  forecasts           Forecast[]
  goals               BusinessGoal[]
  conversations       AIConversation[]
  customers           Customer[]
  khaataEntries       KhaataEntry[]
  notificationLogs    NotificationLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model BankAccount {
  id            String        @id @default(uuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  accountType   String        @default("CURRENT")
  balance       Float         @default(0)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Transaction {
  id              String       @id @default(uuid())
  accountId       String
  account         BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount          Float
  type            String
  category        String
  merchant        String?
  description     String
  isBusiness      Boolean      @default(true)
  confidence      Float        @default(1.0)
  channel         String?
  reference       String?
  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())
}

model BusinessMetric {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodType     String   @default("MONTHLY")
  periodDate     DateTime @default(now())
  totalRevenue   Float
  totalExpenses  Float
  netCashFlow    Float
  endingBalance  Float
  cashRunwayDays Int
  healthScore    Int
  createdAt      DateTime @default(now())
}

model FinancialSignal {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        String
  severity    String
  title       String
  description String
  score       Float
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Alert {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  severity   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Forecast {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projectedDate    DateTime
  projectedRevenue Float
  projectedExpense Float
  projectedBalance Float
  confidenceLower  Float?
  confidenceUpper  Float?
  createdAt        DateTime @default(now())
}

model BusinessGoal {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String
  targetValue  Float
  currentValue Float     @default(0)
  targetDate   DateTime?
  status       String    @default("IN_PROGRESS")
  createdAt    DateTime  @default(now())
}

model AIConversation {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String      @default("Financial Analysis")
  messages   AIMessage[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolsUsed      String?
  createdAt      DateTime       @default(now())
}

model Customer {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  email               String?
  address             String?
  whatsappConsent     Boolean           @default(false)
  emailConsent        Boolean           @default(false)
  remindersEnabled    Boolean           @default(false)
  preferredLanguage   String            @default("en") // en, hi, te
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  entries             KhaataEntry[]
  notificationLogs    NotificationLog[]
}

model KhaataEntry {
  id                  String            @id @default(uuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String
  phone               String?
  amount              Float
  type                String            @default("GAVE") // GAVE (credit given) or RECEIVED (payment collected)
  description         String
  dueDate             DateTime?
  status              String            @default("PENDING") // PENDING or SETTLED
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  notificationLogs    NotificationLog[]
}

model NotificationLog {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  khaataEntryId  String?
  khaataEntry    KhaataEntry? @relation(fields: [khaataEntryId], references: [id], onDelete: SetNull)
  type           String       // CREDIT_CREATED, PAYMENT_RECEIVED, REMINDER_DUE_SOON, REMINDER_DUE_TODAY, REMINDER_OVERDUE_1, REMINDER_OVERDUE_2
  channel        String       // WHATSAPP, EMAIL
  recipient      String       // Phone number or email address
  status         String       @default("PENDING") // PENDING, ACCEPTED, SENT, DELIVERED, FAILED, CANCELLED
  providerId     String?      // Twilio Message SID or Resend Email ID
  idempotencyKey String?      @unique
  failureReason  String?
  metadata       String?      // JSON string of payload details
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId])
  @@index([customerId])
  @@index([khaataEntryId])
  @@index([status])
}