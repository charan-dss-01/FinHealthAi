datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  phone             String?
  name              String
  passwordHash      String?
  role              String     @default("OWNER")
  preferredLanguage String     @default("en")
  businesses        Business[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Business {
  id                  String            @id @default(uuid())
  ownerId             String
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  category            String
  size                String?
  location            String?
  monthlyRevenueRange String?
  employeeCount       Int               @default(1)
  currency            String            @default("INR")
  bankAccounts        BankAccount[]
  transactions        Transaction[]
  metrics             BusinessMetric[]
  signals             FinancialSignal[]
  alerts              Alert[]
  forecasts           Forecast[]
  goals               BusinessGoal[]
  conversations       AIConversation[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model BankAccount {
  id            String        @id @default(uuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  accountType   String        @default("CURRENT")
  balance       Float         @default(0)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Transaction {
  id              String       @id @default(uuid())
  accountId       String
  account         BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount          Float
  type            String
  category        String
  merchant        String?
  description     String
  isBusiness      Boolean      @default(true)
  confidence      Float        @default(1.0)
  channel         String?
  reference       String?
  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())
}

model BusinessMetric {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodType     String   @default("MONTHLY")
  periodDate     DateTime @default(now())
  totalRevenue   Float
  totalExpenses  Float
  netCashFlow    Float
  endingBalance  Float
  cashRunwayDays Int
  healthScore    Int
  createdAt      DateTime @default(now())
}

model FinancialSignal {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        String
  severity    String
  title       String
  description String
  score       Float
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Alert {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  severity   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Forecast {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projectedDate    DateTime
  projectedRevenue Float
  projectedExpense Float
  projectedBalance Float
  confidenceLower  Float?
  confidenceUpper  Float?
  createdAt        DateTime @default(now())
}

model BusinessGoal {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String
  targetValue  Float
  currentValue Float     @default(0)
  targetDate   DateTime?
  status       String    @default("IN_PROGRESS")
  createdAt    DateTime  @default(now())
}

model AIConversation {
  id         String      @id @default(uuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String      @default("Financial Analysis")
  messages   AIMessage[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolsUsed      String?
  createdAt      DateTime       @default(now())
}